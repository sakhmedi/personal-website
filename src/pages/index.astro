---
import Layout from '../layouts/Layout.astro';
import Cards from '../components/Cards.astro';
import Form from '../components/Form.astro';
import Footer from '../components/Footer.astro';
import ChatIcon from '../components/ChatIcon.astro';
import Pager from '../components/Pager.astro';
import { featuredProjects } from '../data/projects';
import { contacts } from '../data/contacts';
import { bio } from '../data/about';

// Тысячи отделяем узким неразрывным пробелом: "80 000" не разорвётся
// на две строки и не расползётся, как с обычным пробелом.
const thin = " ";
// Перед ₸ неразрывный пробел: знак валюты не уезжает на новую строку.
const nbsp = "\u00A0";

// Прайс. Цена "от" стоит только там, где нижняя граница честно известна;
// у доработки её нет, она зависит от объёма.
const services = [
  {
    name: "Сайт на одну страницу",
    price: `80${thin}000`,
    time: "обычно 2–3 дня",
    about:
      "Когда про вас должны узнать и написать, этого достаточно. Вы рассказываете о себе, а клиент нажимает кнопку и пишет вам.",
    includes: [
      "страница о вас и о том, что вы предлагаете",
      "кнопка, чтобы клиент написал вам",
      "сайт удобно открывать с телефона",
      "два круга правок",
      "домен и хостинг оформлены на вас",
    ],
  },
  {
    name: "Сайт из нескольких страниц",
    price: `150${thin}000`,
    time: "обычно около 7 дней",
    about:
      "Нужно рассказать больше, чем помещается на одну страницу. У услуг, цен и фотографий будет своё место.",
    includes: [
      "отдельные страницы для услуг, цен и фотографий",
      "кнопка, чтобы клиент написал вам",
      "сайт удобно открывать с телефона",
      "два круга правок",
      "домен и хостинг оформлены на вас",
    ],
  },
  {
    name: "Доработка сайта",
    price: null,
    time: null,
    about:
      "Сайт уже есть, но вам в нём что-то не нравится. Чаще всего его можно доработать, а не делать заново. Я посмотрю и честно скажу, что с ним стоит сделать.",
    includes: [
      "срок и цену назову, когда посмотрю сайт и мы договоримся, что в нём менять",
      "если домен и хостинг у вас уже есть, работаю с ними",
      "все аккаунты и доступы остаются у вас",
    ],
  },
];

// Режим работы: что происходит и сколько вы платите мне на каждом шаге.
// Правая колонка, прочитанная сверху вниз, и есть вся схема оплаты:
// в ней только суммы, без слов, чтобы её можно было сложить глазами.
// Домен и хостинг сюда не входят: их клиент оплачивает не мне.
const steps = [
  {
    title: "Разговор",
    pay: `0${nbsp}₸`,
    text: "Платить ничего не нужно. Вы расскажете про свой бизнес, я задам несколько вопросов. В конце разговора я называю срок и цену.",
  },
  {
    title: "Предоплата",
    pay: "50%",
    text: `Если цена и срок подходят, вы платите половину, и я начинаю работу. Например, если сайт стоит 80${thin}000${nbsp}₸, сейчас вы платите 40${thin}000${nbsp}₸. Вторую половину — только когда увидите готовый сайт и он вас устроит. Если по ходу понадобятся тексты или фотографии, напишу вам.`,
  },
  {
    title: "Работа",
    pay: `0${nbsp}₸`,
    text: "Готовый сайт вы увидите до запуска. Откроете со своего телефона, посмотрите и скажете, что поправить. На этом шаге ещё можно поменять тексты и фотографии.",
  },
  {
    title: "Приёмка",
    pay: "50%",
    text: "Два круга правок входят в цену, дальше по договорённости. Когда сайт вас устраивает, вы платите вторую половину.",
  },
  {
    title: "Запуск",
    pay: `0${nbsp}₸`,
    text: "Я отдаю вам все доступы — логины и пароли от домена, хостинга и всего, на чём работает сайт. Сайт остаётся вашим: если вы когда-нибудь уйдёте к другому разработчику, просить что-то у меня не придётся.",
  },
];

// Обещания в "Обо мне": не новые факты, а тот же порядок работы,
// сказанный коротко там, где человек решает, доверять ли.
const promises = [
  "цену и срок называю до того, как вы что-то заплатите",
  "готовый сайт вы смотрите со своего телефона до запуска",
  "вторую половину платите, только когда сайт вас устроит",
  "все логины и пароли отдаю вам",
];

const links = [
  { label: "Telegram", href: contacts.telegram, text: "@saliima_s" },
  { label: "Почта", href: `mailto:${contacts.email}`, text: contacts.email },
];
---
<Layout
  title="Сайты для бизнеса в Астане"
  description="Сайты для небольшого бизнеса в Астане. Сделаю новый или доработаю тот, что уже есть."
  footer={false}
>
  <div data-screen-count="6" hidden></div>

  <!-- 1. КТО И ЧТО. Кобальтовое поле. Заголовок во всю ширину, под ним
       строка про клиента, табличка "на связи" и жёлтая плитка "написать".
       Всё одной группой по центру экрана: без панно разнесённые к краям
       блоки оставляли посередине пустую полосу. -->
  <section class="screen screen-cobalt" data-screen="1" aria-labelledby="hero-title">
    <div class="shell screen-body !gap-8 lg:!gap-16">
      <h1 id="hero-title" class="display display-hero max-w-[16ch]">
        Делаю сайты для бизнеса в Астане
      </h1>

      <div class="flex flex-col gap-6 lg:grid lg:grid-cols-12 lg:items-start lg:gap-x-8">
        <p class="measure text-lg text-on-cobalt-muted md:text-xl lg:col-span-6">
          Ваш клиент открывает сайт с телефона, за пару секунд находит то,
          что искал, и пишет вам в WhatsApp.
        </p>

        <div class="flex flex-col gap-4 lg:col-span-5 lg:col-start-8 lg:items-stretch">
          <p class="tile self-start !px-4 !py-3 font-medium lg:self-stretch">
            <span class="font-bold">На связи:</span> отвечаю в течение дня
          </p>

          <a
            href={contacts.whatsapp}
            target="_blank"
            rel="noopener noreferrer"
            class="smalt self-stretch"
            data-cta
          >
            <ChatIcon size={24} />
            Написать в WhatsApp
            <span class="sr-only">(откроется в новой вкладке)</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. РАБОТЫ. Ночной кобальт. Работы — плитки, на телефоне листаются
       вбок, у каждой честно написано, что это. -->
  <section id="works" class="screen screen-deep" data-screen="2" aria-labelledby="works-title">
    <div class="shell screen-body lg:grid lg:grid-cols-12 lg:items-center lg:gap-x-8">
      <div class="flex flex-col gap-4 lg:col-span-4">
        <!-- На телефоне ссылка на все работы стоит в строке заголовка:
             отдельной строкой под плитками экран не помещался в окно. -->
        <div class="flex items-baseline justify-between gap-4">
          <h2 id="works-title" class="display display-lg">Работы</h2>
          <a href="/projects" class="field-link inline-flex min-h-[44px] items-center font-semibold lg:hidden">
            Все работы
          </a>
        </div>
        <p class="measure text-[0.9375rem] text-on-cobalt-muted md:text-base">
          Под каждой работой написано, что это. Концепт — сайт, который
          я сделала не по заказу, а чтобы показать, каким может быть сайт
          такого бизнеса.
        </p>
        <a href="/projects" class="field-link hidden min-h-[44px] items-center self-start font-semibold lg:inline-flex">
          Все работы
        </a>
      </div>

      <Pager label="Работы" item="Работа" cols={2} class="lg:col-span-8">
        {featuredProjects.map((project, index) => (
          <Cards project={project} eager={index === 0} index={index} />
        ))}
      </Pager>
    </div>
  </section>

  <!-- 3. ЦЕНЫ. Кобальт. Три тарифа — три плитки: на телефоне листаются,
       на компьютере стоят рядом. Цена — самое крупное на плитке. -->
  <section id="services" class="screen screen-cobalt" data-screen="3" aria-labelledby="services-title">
    <div class="shell screen-body">
      <h2 id="services-title" class="display display-lg">Цены и сроки</h2>

      <Pager label="Тарифы и оплата домена" item="Плитка" cols={3}>
        {services.map((service, index) => (
          <article class="tile flex flex-col gap-2.5" data-lay style={`--i: ${index}`}>
            <h3 class="display display-md lg:min-h-[3.12em]">{service.name}</h3>
            {service.price ? (
              <p class="price"><small>от </small>{service.price}<small>{nbsp}₸</small></p>
            ) : (
              <p class="price"><small>по объёму</small></p>
            )}
            {service.time && <p class="font-semibold">Срок: {service.time}</p>}
            <p class="text-[0.9375rem]">{service.about}</p>
            <div class="mt-1 border-t border-stone-line pt-3">
              {service.price && <p class="label mb-2 text-ink-muted">Что входит</p>}
              <ul class="ticks flex flex-col gap-1 text-[0.9375rem]">
                {service.includes.map((item) => <li>{item}</li>)}
              </ul>
            </div>
          </article>
        ))}
        <!-- Цену домена и хостинга не называем: она зависит от того, что
             выберет клиент, а придумывать "примерно" нечестно. На телефоне
             это последняя плитка ряда, на компьютере — полоса под тарифами. -->
        <div class="tile flex items-center lg:col-span-3 lg:!py-4" data-lay style="--i: 3">
          <p class="measure text-[0.9375rem] text-ink-muted lg:max-w-none">
            Домен и хостинг вы оплачиваете отдельно, их цена зависит от того,
            какие вы выберете. Оформляются они на ваше имя, и все логины и пароли
            от этих аккаунтов у вас.
          </p>
        </div>
      </Pager>
    </div>
  </section>

  <!-- 4. КАК Я РАБОТАЮ. Ночной кобальт. Пять шагов — пять плиток. На каждой
       крупно то, что вы платите мне на этом шаге: 0 ₸, 50%, 0 ₸, 50%, 0 ₸. -->
  <section id="process" class="screen screen-deep" data-screen="4" aria-labelledby="process-title">
    <div class="shell screen-body">
      <div class="flex flex-col gap-3">
        <h2 id="process-title" class="display display-lg">Как я работаю</h2>
        <p class="measure text-[0.9375rem] text-on-cobalt-muted md:text-base">
          Если вы раньше не заказывали сайт, вот как это обычно проходит.
          Платите вы два раза, по половине: в начале работы и когда готовый
          сайт вас устроит.
        </p>
      </div>

      <Pager label="Шаги работы" item="Шаг" cols={5}>
        {steps.map((step, index) => (
          <article class="tile flex flex-col gap-3" data-lay style={`--i: ${index}`}>
            <div class="flex flex-col gap-2">
              <h3 class="display display-md lg:!text-[1.25rem]">{step.title}</h3>
              <p class="flex flex-col gap-1">
                <span class="label text-ink-muted">Вы платите мне</span>
                <span class:list={["price self-start", step.pay !== `0${nbsp}₸` && "rounded-[2px] bg-terracotta px-2 py-1.5 text-on-cobalt"]}>{step.pay}</span>
              </p>
            </div>
            <p class="text-[0.9375rem]">{step.text}</p>
          </article>
        ))}
      </Pager>
    </div>
  </section>

  <!-- 5. ОБО МНЕ. Терракота — единственный тёплый экран: здесь человек.
       Одна каменная плитка: имя, две строки о себе и обещания. -->
  <section id="about" class="screen screen-terracotta" data-screen="5" aria-labelledby="about-title">
    <div class="shell screen-body">
      <h2 id="about-title" class="display display-lg">Обо мне</h2>

      <div class="tile flex max-w-[48rem] flex-col gap-4" data-lay style="--i: 0">
        <p class="display display-lg">{contacts.name}</p>
        {bio.map((line) => <p class="measure md:text-lg">{line}</p>)}
        <ul class="ticks flex flex-col gap-1.5 border-t border-stone-line pt-4">
          {promises.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- 6. НАПИШИТЕ МНЕ. Ночной кобальт, снова жёлтая плитка: страница
       заканчивается тем же действием, с которого началась. На телефоне
       это два экрана — WhatsApp и форма, — на компьютере один. -->
  <section id="contacts" class="contacts screen-deep" data-screen="6" aria-labelledby="contacts-title">
    <div class="contacts-part">
      <div class="shell screen-body lg:justify-start">
        <h2 id="contacts-title" class="display display-xl">Напишите мне</h2>
        <p class="measure text-lg text-on-cobalt-muted">
          Быстрее всего в WhatsApp. Отвечаю в течение дня.
        </p>

        <a
          href={contacts.whatsapp}
          target="_blank"
          rel="noopener noreferrer"
          class="smalt self-stretch sm:self-start"
          data-cta
        >
          <ChatIcon size={24} />
          Написать в WhatsApp
          <span class="sr-only">(откроется в новой вкладке)</span>
        </a>

        <ul class="flex flex-col">
          {links.map(({ label, href, text }) => (
            <li>
              <a
                href={href}
                target={href.startsWith("mailto:") ? undefined : "_blank"}
                rel={href.startsWith("mailto:") ? undefined : "noopener noreferrer"}
                class="flex min-h-[48px] flex-wrap items-center gap-x-4"
              >
                <span class="w-20 text-[0.9375rem] text-on-cobalt-muted">{label}</span>
                <span class="field-link break-all">{text}</span>
              </a>
            </li>
          ))}
        </ul>

      </div>
    </div>

    <div class="contacts-part">
      <div class="shell screen-body">
        <div class="tile" data-lay style="--i: 1">
          <p class="mb-5 text-lg font-semibold">Или оставьте заявку, и я напишу вам сама.</p>
          <Form />
        </div>
      </div>
    </div>

    <div class="contacts-footer">
      <Footer />
    </div>
  </section>
</Layout>
