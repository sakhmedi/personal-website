---
import Layout from '../layouts/Layout.astro';
import Cards from '../components/Cards.astro';
import Form from '../components/Form.astro';
import { featuredProjects } from '../data/projects';
import { contacts } from '../data/contacts';

// Секции разделены волосяной линией, а не коробками: единственный
// прямоугольник на странице — карточка работы.
const section = "mx-auto max-w-[1120px] px-5 py-16 md:py-24";

// Всё, что можно вбить в адресную строку или в мессенджер, набрано
// моноширинным. Подпись слева говорит, куда именно это вбивать.
const links = [
  { label: "Telegram", href: contacts.telegram, text: "@saliima_s" },
  { label: "Почта", href: `mailto:${contacts.email}`, text: contacts.email },
  { label: "GitHub", href: contacts.github, text: "github.com/sakhmedi" },
];
---
<Layout
  title="Сайты для бизнеса в Астане"
  description="Сайты для небольшого бизнеса в Астане. Сделаю новый или доработаю тот, что уже есть."
>
  <!-- ГЛАВНЫЙ ЭКРАН. Держим коротким: герой страницы — работы,
       и на десктопе первая карточка должна попадать в первый экран. -->
  <section class="mx-auto max-w-[1120px] px-5 pt-12 pb-16 md:pt-16 md:pb-24">
    <h1 class="measure mb-5">Делаю сайты для бизнеса в Астане</h1>
    <p class="measure mb-8 text-[1.0625rem] text-text-muted md:text-[1.1875rem]">
      Ваш клиент открывает сайт с телефона, за пару секунд находит то, что искал,
      и пишет вам в WhatsApp.
    </p>
    <a href={contacts.whatsapp} target="_blank" rel="noopener noreferrer" class="btn">
      Написать в WhatsApp
    </a>
  </section>

  <!-- РАБОТЫ -->
  <section id="works" class={`${section} scroll-mt-4`}>
    <h2 class="mb-4">Работы</h2>
    <p class="measure mb-8 text-text-muted">
      Под каждой работой написано, что это. Концепт — сайт, который я сделала
      не по заказу, а чтобы показать, каким может быть сайт такого бизнеса.
    </p>

    <div class="grid gap-x-6 gap-y-12 md:grid-cols-2">
      {featuredProjects.map((project, index) => (
        <Cards project={project} eager={index === 0} />
      ))}
    </div>

    <a href="/projects" class="mt-10 inline-flex min-h-[44px] items-center text-accent underline underline-offset-4 hover:text-accent-hover">
      Все работы
    </a>
  </section>

  <!-- ЧТО Я ДЕЛАЮ. Цена стоит сразу под услугой и набрана моноширинным:
       это данные, а не проза. У доработки цены нет, она зависит от объёма,
       и придумывать "от" там нечестно. -->
  <section id="services" class={`${section} scroll-mt-4`}>
    <h2 class="mb-4">Что я делаю</h2>
    <p class="measure mb-8 text-text-muted">
      «От» значит, что дешевле не бывает. Точную цену и срок я назову после
      первого разговора, и он ничего не стоит.
    </p>

    <!-- Услуга: подзаголовок с ценой, под ним что это, что входит и срок.
         Между услугами воздуха в пять раз больше, чем внутри, поэтому
         границы видно без единой линии и без коробок. -->
    <div class="measure flex flex-col gap-10">
      <div class="flex flex-col gap-2">
        <h3>Сайт на одну страницу, <span class="price">от <span class="num">80 000</span> ₸</span></h3>
        <p>
          Когда про вас должны узнать и написать, этого достаточно.
          Вы рассказываете о себе, а клиент нажимает кнопку и пишет вам.
        </p>
        <p>
          <span class="font-medium">Что входит:</span> страница о вас и о том,
          что вы предлагаете; кнопка, чтобы клиент написал вам; сайт удобно
          открывать с телефона; два круга правок; домен и хостинг оформлены на вас.
        </p>
        <p><span class="font-medium">Срок:</span> обычно 2–3 дня.</p>
      </div>

      <div class="flex flex-col gap-2">
        <h3>Сайт из нескольких страниц, <span class="price">от <span class="num">150 000</span> ₸</span></h3>
        <p>
          Нужно рассказать больше, чем помещается на одну страницу.
          У услуг, цен и фотографий будет своё место.
        </p>
        <p>
          <span class="font-medium">Что входит:</span> отдельные страницы для
          услуг, цен и фотографий; кнопка, чтобы клиент написал вам; сайт удобно
          открывать с телефона; два круга правок; домен и хостинг оформлены на вас.
        </p>
        <p><span class="font-medium">Срок:</span> обычно около 7 дней.</p>
      </div>

      <div class="flex flex-col gap-2">
        <h3>Доработка сайта, <span class="price">цена по объёму</span></h3>
        <p>
          Сайт уже есть, но вам в нём что-то не нравится. Чаще всего его
          можно доработать, а не делать заново. Я посмотрю и честно скажу,
          что с ним стоит сделать.
        </p>
        <p>
          <span class="font-medium">Срок и цена:</span> назову, когда посмотрю
          сайт и мы договоримся, что в нём менять.
        </p>
        <p>
          Если домен и хостинг у вас уже есть, работаю с ними. Все аккаунты
          и доступы остаются у вас.
        </p>
      </div>
    </div>

    <!-- Цену домена и хостинга не называем: она зависит от того, что
         выберет клиент, а придумывать "примерно" нечестно. -->
    <p class="measure mt-10 text-text-muted">
      Домен и хостинг вы оплачиваете отдельно, их цена зависит от того,
      какие вы выберете. Оформляются они на ваше имя, и все логины и пароли
      от этих аккаунтов у вас.
    </p>
  </section>

  <!-- КАК Я РАБОТАЮ. Список нумерованный по смыслу (это порядок, а не
       набор), но номера не показываем: последовательность держат слова
       "сначала", "когда", "потом". Скринридер порядок всё равно объявит.
       Каждый шаг начинается с жирного итога: что происходит и сколько
       вы платите. Пробежав глазами только их, человек видит всю оплату. -->
  <section id="process" class={`${section} scroll-mt-4`}>
    <h2 class="mb-4">Как я работаю</h2>
    <p class="measure mb-4 text-text-muted">
      Если вы раньше не заказывали сайт, вот как это обычно проходит.
      Платите вы два раза, по половине.
    </p>
    <p class="measure mb-8 font-medium">
      <span class="whitespace-nowrap">Разговор, 0 ₸</span> → <span class="whitespace-nowrap">предоплата 50%</span> → <span class="whitespace-nowrap">работа</span> → <span class="whitespace-nowrap">вторые 50%</span> → <span class="whitespace-nowrap">все доступы у вас</span>
    </p>

    <ol class="measure flex flex-col gap-5">
      <li>
        <strong>Разговор. Платить ничего не нужно.</strong> Вы расскажете про
        свой бизнес, я задам несколько вопросов. В конце разговора я называю
        срок и цену.
      </li>
      <li>
        <strong>Предоплата 50%, и я начинаю работу.</strong> Например, если сайт
        стоит <span class="whitespace-nowrap">80 000 ₸</span>, сейчас вы платите
        <span class="whitespace-nowrap">40 000 ₸</span>. Если по ходу понадобятся
        тексты или фотографии, напишу вам.
      </li>
      <li>
        <strong>Вы смотрите сайт до запуска.</strong> Откроете со своего телефона,
        посмотрите и скажете, что поправить. На этом шаге ещё можно поменять
        тексты и фотографии.
      </li>
      <li>
        <strong>Правки, потом вторые 50%.</strong> Два круга правок входят в цену,
        дальше по договорённости. Когда сайт вас устраивает, вы платите вторую
        половину.
      </li>
      <li>
        <strong>Запуск. Все доступы у вас.</strong> Доступы — это логины и пароли
        от домена, хостинга и всего, на чём работает сайт. Я отдаю их вам, и сайт
        остаётся вашим. Если вы когда-нибудь уйдёте к другому разработчику,
        просить что-то у меня не придётся.
      </li>
    </ol>
  </section>

  <!-- КОНТАКТЫ. Единственная залитая секция на странице: лист
       заканчивается плотной полосой, и вместе с подвалом она читается
       как одно основание страницы, а не как полоска посередине. -->
  <div class="band bg-surface">
    <section id="contacts" class={`${section} scroll-mt-4`}>
      <h2 class="mb-4">Контакты</h2>
      <p class="measure mb-8 text-text-muted">
        Быстрее всего написать в WhatsApp. Отвечаю в течение дня.
      </p>

      <a href={contacts.whatsapp} target="_blank" rel="noopener noreferrer" class="btn">
        Написать в WhatsApp
      </a>

      <ul class="mt-8 flex flex-col">
        {links.map(({ label, href, text }) => (
          <li>
            <a
              href={href}
              target={href.startsWith("mailto:") ? undefined : "_blank"}
              rel={href.startsWith("mailto:") ? undefined : "noopener noreferrer"}
              class="flex min-h-[44px] flex-wrap items-center gap-x-4"
            >
              <span class="w-20 text-sm text-text-muted">{label}</span>
              <span class="addr text-accent underline underline-offset-4">{text}</span>
            </a>
          </li>
        ))}
      </ul>

      <p class="measure mt-12 mb-5 text-text-muted">Или оставьте заявку, и я напишу вам сама.</p>
      <Form />
    </section>
  </div>
</Layout>
