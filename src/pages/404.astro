---
import Layout from '../layouts/Layout.astro';
---
<Layout
  title="Страница не найдена"
  description="Такой страницы на сайте нет."
>
  <!-- Страница ошибки выровнена по левому краю, как и всё остальное:
       отдельной вёрстки под неё нет, есть та же колонка. -->
  <section class="mx-auto max-w-[1120px] px-5 py-16 md:py-24">
    <p class="addr mb-4 text-text-muted">404</p>
    <h1 class="measure mb-4">Такой страницы нет</h1>
    <p class="measure mb-8 text-text-muted">
      Возможно, в адресе опечатка или страница переехала.
    </p>
    <a href="/" class="btn">На главную</a>
  </section>
</Layout>
