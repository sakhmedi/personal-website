---
import Layout from '../layouts/Layout.astro';
---
<Layout
  title="Страница не найдена"
  description="Такой страницы на сайте нет."
>
  <section class="band">
    <div class="wrap py-24 md:py-32">
      <p class="eyebrow">Ошибка 404</p>
      <h1 class="measure mb-5">Такой страницы нет</h1>
      <p class="lead measure mb-9">
        Возможно, в адресе опечатка или страница переехала.
      </p>
      <div class="flex flex-col gap-3 sm:flex-row">
        <a href="/" class="btn">На главную</a>
        <a href="/projects" class="btn-ghost">Посмотреть работы</a>
      </div>
    </div>
  </section>
</Layout>
