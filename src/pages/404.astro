---
import Layout from '../layouts/Layout.astro';
---
<Layout
  title="Страница не найдена"
  description="Такой страницы на сайте нет."
>
  <!-- Что случилось и куда идти. -->
  <section class="screen screen-cobalt" data-screen="1" aria-labelledby="missing-title">
    <div class="shell screen-body items-start">
      <h1 id="missing-title" class="display display-xl max-w-[14ch]">Такой страницы нет</h1>
      <div class="tile max-w-[32rem]">
        <p class="mb-6">
          Возможно, в адресе опечатка или страница переехала. Всё главное
          есть на главной: работы, цены и как со мной связаться.
        </p>
        <a href="/" class="btn">На главную</a>
      </div>
    </div>
  </section>
</Layout>
