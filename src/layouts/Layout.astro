---
import '../styles/global.css'
import Header from "../components/Header.astro"
import Footer from "../components/Footer.astro"

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

// Абсолютный адрес текущей страницы.
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url);

// Картинка для карточки ссылки. Одна на все страницы: она показывает,
// чем я занимаюсь, а не что на конкретной странице, и в ленте мессенджера
// её видно размером с ноготь.
const ogImage = new URL("/og.png", Astro.site ?? Astro.url);
const ogImageAlt =
  "Надпись «Делаю сайты для бизнеса в Астане» на тёмном стекле двери, под ней «Салима · Астана» и жёлтая наклейка «Написать в WhatsApp»";
---

<!doctype html>
<html lang="ru">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />

		<!-- Карточка ссылки в WhatsApp, Telegram и соцсетях. -->
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Салима" />
		<meta property="og:locale" content="ru_RU" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={ogImageAlt} />
		<!-- summary_large_image: под картинку 1200x630. С обычным summary
		     её обрезали бы в маленький квадрат. -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:image" content={ogImage} />
		<meta name="twitter:image:alt" content={ogImageAlt} />

		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="theme-color" content="#0e2a2f" />
		<script is:inline>
			// Метка для CSS: JavaScript работает, створкам витрины можно
			// появиться и разъехаться. Без неё створок нет вовсе.
			document.documentElement.classList.add("js");
		</script>
	</head>
	<body>
		<!-- Для тех, кто ходит по сайту клавишей Tab: сразу к содержанию,
		     мимо логотипа и меню. Видна только в фокусе. -->
		<a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[60] focus:rounded-[8px] focus:bg-sticker focus:px-4 focus:py-3 focus:font-bold focus:text-on-sticker">
			К содержанию
		</a>
		<Header/>
		<main id="main" tabindex="-1" class="min-h-screen focus:outline-none">
			<slot />
		</main>
		<Footer/>
	</body>
</html>
