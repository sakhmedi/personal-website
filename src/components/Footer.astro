---
import { contacts } from '../data/contacts';

// Год берётся из даты сборки — в январе не придётся вспоминать про подвал.
const year = new Date().getFullYear();
---
<!-- Подвал — порог под дверью: глубокое стекло, имя и ссылка на GitHub
     для тех, кому интересен код. Клиенту она не нужна, поэтому живёт здесь,
     а не в контактах. -->
<footer class="bg-glass-deep">
  <div class="shell flex flex-wrap items-center justify-between gap-x-6 gap-y-2 py-8 text-[0.9375rem] text-vinyl-muted">
    <p>{contacts.name} · {contacts.city} · {year}</p>
    <a href={contacts.github} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-[44px] items-center underline underline-offset-[0.25em] hover:text-vinyl">
      GitHub
      <span class="sr-only">(откроется в новой вкладке)</span>
    </a>
  </div>
</footer>
