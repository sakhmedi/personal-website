---
import { contacts } from '../data/contacts';

// Год берётся из даты сборки — в январе не придётся вспоминать про подвал.
const year = new Date().getFullYear();
---
<!-- Подвал — нижняя кромка панно: имя, город и год. На главной подвал
     стоит внутри последнего экрана. -->
<footer class="border-t-[var(--seam)] border-cobalt">
  <div class="shell flex min-h-[3.75rem] items-center py-4 text-[0.9375rem] text-on-cobalt-muted">
    <p>{contacts.name} · {contacts.city} · {year}</p>
  </div>
</footer>
