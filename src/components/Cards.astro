---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  /** Первая работа видна сразу — её картинку грузим не лениво. */
  eager?: boolean;
}

const { project, eager = false } = Astro.props;

// Astro оптимизирует только те картинки, про которые знает на сборке.
// Импортировать по переменной нельзя, поэтому забираем всю папку разом,
// а нужный файл достаём по имени из данных.
const screens = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/screens/*.png',
  { eager: true }
);
const screen = project.image
  ? screens[`../assets/screens/${project.image}`]?.default
  : undefined;

// Домен показываем рядом со словами "Открыть сайт": адрес можно
// проверить, обещание — нет. Параметры и www. только мешают читать.
const host = new URL(project.url).hostname.replace(/^www\./, '');
---

<!-- Работа в витрине: сайт на экране телефона, как его увидит клиент,
     под ним на нитке бумажная бирка с названием и статусом. Ссылка
     растянута на всю работу через ::after: на телефоне так не промахнуться. -->
<article class="group relative flex flex-col items-center self-start">
  {screen && (
    <div class="phone w-full max-w-[17rem] transition-transform duration-200 group-hover:-translate-y-1 motion-reduce:transition-none motion-reduce:group-hover:translate-y-0">
      <Image
        src={screen}
        alt={project.imageAlt}
        widths={[320, 640]}
        sizes="17rem"
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : 'auto'}
      />
    </div>
  )}

  <div class="tag mt-6 flex w-full max-w-[19rem] flex-col gap-1.5">
    <h3 class="text-lg font-bold leading-tight">{project.title}</h3>
    <p class="text-[0.9375rem] font-medium text-ink-muted">{project.subtitle}</p>
    <p class="text-[0.9375rem] leading-relaxed">{project.description}</p>

    <a
      href={project.url}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex min-h-[44px] flex-wrap items-center gap-x-1.5 pt-2 text-[0.9375rem] font-medium text-link underline underline-offset-[0.2em] after:absolute after:inset-0 group-hover:decoration-2"
    >
      Открыть сайт <span class="font-normal text-ink-muted no-underline">{host}</span>
      <span class="sr-only">(откроется в новой вкладке)</span>
    </a>
  </div>
</article>
