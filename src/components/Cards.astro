---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  /** Первая работа видна сразу — её картинку грузим не лениво. */
  eager?: boolean;
  /** Порядок плитки при укладке экрана. */
  index?: number;
}

const { project, eager = false, index = 0 } = Astro.props;

// Astro оптимизирует только те картинки, про которые знает на сборке.
// Импортировать по переменной нельзя, поэтому забираем всю папку разом,
// а нужный файл достаём по имени из данных.
const screens = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/screens/*.png',
  { eager: true }
);
const screen = project.image
  ? screens[`../assets/screens/${project.image}`]?.default
  : undefined;

// Домен показываем рядом со словами "Открыть сайт": адрес можно
// проверить, обещание — нет. Параметры и www. только мешают читать.
const host = new URL(project.url).hostname.replace(/^www\./, '');
---

<!-- Работа — плитка панно: сайт на экране телефона, как его увидит
     клиент, рядом название и статус. Ссылка открывает сайт только
     с текста и с картинки, а не со всей плитки: на телефоне плитки
     листают пальцем, и случайное касание не должно уводить на чужой сайт. -->
<article class="tile flex flex-col gap-4" data-lay style={`--i: ${index + 1}`}>
  {screen && (
    <a
      href={project.url}
      target="_blank"
      rel="noopener noreferrer"
      class="phone flex-none lg:self-center"
      tabindex="-1"
      aria-hidden="true"
    >
      <Image
        src={screen}
        alt=""
        widths={[320, 640]}
        sizes="13rem"
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : 'auto'}
      />
    </a>
  )}

  <div class="flex min-w-0 flex-col gap-1.5">
    <h3 class="display display-md [overflow-wrap:anywhere]">{project.title}</h3>
    <p class="label text-terracotta-ink">{project.subtitle}</p>
    <p class="mt-1 text-[0.9375rem] leading-relaxed">{project.description}</p>
    {screen && <p class="sr-only">На картинке: {project.imageAlt}.</p>}

    <a
      href={project.url}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex min-h-[44px] flex-wrap items-center gap-x-1.5 text-[0.9375rem] font-semibold"
    >
      Открыть сайт <span class="font-normal text-ink-muted no-underline">{host}</span>
      <span class="sr-only">(откроется в новой вкладке)</span>
    </a>
  </div>
</article>
