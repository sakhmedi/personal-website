---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  /** Первая карточка на главной видна сразу — её картинку грузим не лениво. */
  eager?: boolean;
}

const { project, eager = false } = Astro.props;

// Astro оптимизирует только те картинки, про которые знает на сборке.
// Импортировать по переменной нельзя, поэтому забираем всю папку разом,
// а нужный файл достаём по имени из данных.
const screens = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/screens/*.png',
  { eager: true }
);
const screen = project.image
  ? screens[`../assets/screens/${project.image}`]?.default
  : undefined;

// Домен стоит в адресной строке окна: адрес можно проверить, обещание — нет.
const host = new URL(project.url).hostname.replace(/^www\./, '');
---

<!-- Работа в окне браузера. Ссылка растянута на всю карточку через
     ::after, так что попасть по ней можно в любом месте. -->
<article class="work group relative flex flex-col">
  <div class="browser">
    <div class="browser-bar" aria-hidden="true">
      <span class="browser-dots"><i></i><i></i><i></i></span>
      <span class="browser-url">{host}</span>
    </div>
    {screen && (
      <Image
        src={screen}
        alt={project.imageAlt}
        widths={[560, 1120]}
        sizes="(min-width: 768px) 540px, calc(100vw - 2.5rem)"
        width={1120}
        height={700}
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : 'auto'}
      />
    )}
  </div>

  <div class="flex grow flex-col gap-3 pt-6">
    <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
      <h3 class="text-xl">{project.title}</h3>
      <span class="tag">{project.subtitle}</span>
    </div>

    <p class="measure text-text-muted">{project.description}</p>

    <a
      href={project.url}
      target="_blank"
      rel="noopener noreferrer"
      class="mt-auto inline-flex min-h-11 items-center gap-2 pt-1 font-semibold text-accent after:absolute after:inset-0 group-hover:text-accent-hover"
    >
      Открыть сайт
      <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
      <span class="sr-only">{host} (откроется в новой вкладке)</span>
    </a>
  </div>
</article>
