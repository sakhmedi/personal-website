---
import { Image } from 'astro:assets';
import salima from '../assets/salima.jpg';
import { contacts, whatsapp } from '../data/contacts';

// Якоря пишем от корня, чтобы ссылки работали и с /projects, и со страницы 404.
const navLinks = [
  { name: "Работы", href: "/#works" },
  { name: "Цены", href: "/#services" },
  { name: "Как я работаю", href: "/#process" },
  { name: "Контакты", href: "/#contacts" },
];

const iconButton =
  "flex h-11 w-11 items-center justify-center rounded-full border border-border text-text hover:border-border-strong";
---
<!-- Шапка — часть ночной полосы и липнет к верху: кнопка «написать»
     на десктопе всегда под рукой. -->
<header class="band sticky top-0 z-40 border-b border-border">
  <div class="wrap flex items-center justify-between gap-6 py-3">
    <a href="/" class="flex items-center gap-3" aria-label="На главную">
      <Image
        src={salima}
        alt=""
        width={96}
        height={96}
        densities={[1, 2]}
        loading="eager"
        class="h-10 w-10 rounded-full object-cover ring-2 ring-sun"
      />
      <span class="flex flex-col leading-tight">
        <span class="font-display text-[0.9375rem] font-semibold">{contacts.name}</span>
        <span class="text-xs text-text-muted">сайты для бизнеса</span>
      </span>
    </a>

    <nav class="hidden md:flex md:items-center md:gap-8" aria-label="Основное меню">
      {navLinks.map(({ name, href }) => (
        <a href={href} class="text-[0.9375rem] text-text-muted transition-colors hover:text-text">
          {name}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={whatsapp()}
        target="_blank"
        rel="noopener noreferrer"
        class="btn hidden min-h-11 py-2 text-[0.9375rem] lg:inline-flex"
      >
        Написать в WhatsApp
      </a>

      <button id="themeToggle" class={iconButton} aria-label="Переключить тему">
        <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true">
          <circle cx="10" cy="10" r="7.25" fill="none" stroke="currentColor" stroke-width="1.5" />
          <path d="M10 2.75a7.25 7.25 0 0 1 0 14.5z" fill="currentColor" />
        </svg>
      </button>

      <button
        id="burgermenu"
        class={`md:hidden ${iconButton}`}
        aria-label="Меню"
        aria-controls="mobileNav"
        aria-expanded="false"
      >
        <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true">
          <path
            d="M3 5.5h14M3 10h14M3 14.5h14"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
          />
        </svg>
      </button>
    </div>
  </div>

  <!-- Видимостью на десктопе управляет только CSS (md:hidden), состоянием
       на телефоне — атрибут hidden. Они не конфликтуют. -->
  <nav
    id="mobileNav"
    hidden
    class="wrap flex flex-col pb-3 md:hidden"
    aria-label="Мобильное меню"
  >
    {navLinks.map(({ name, href }) => (
      <a href={href} class="flex min-h-12 items-center border-t border-border text-text">{name}</a>
    ))}
  </nav>
</header>

<!-- Липкая кнопка: на телефоне связаться можно в любой момент, не
     возвращаясь наверх. Высота и запас под жест «домой» на айфоне учтены
     в отступе body (--sticky-cta). -->
<a
  href={whatsapp()}
  target="_blank"
  rel="noopener noreferrer"
  class="fixed inset-x-0 bottom-0 z-50 flex min-h-[var(--sticky-cta)] items-center justify-center bg-sun pb-[env(safe-area-inset-bottom,0px)] text-center font-semibold text-on-sun shadow-[0_-8px_24px_-12px_rgb(0_0_0/0.3)] focus-visible:outline-offset-[-4px] lg:hidden"
>
  Написать в WhatsApp
</a>

<script>
  // === БУРГЕР-МЕНЮ ===
  const burger = document.getElementById("burgermenu");
  const panel = document.getElementById("mobileNav");
  const desktop = window.matchMedia("(min-width: 768px)");

  if (burger && panel) {
    const setOpen = (open: boolean) => {
      panel.hidden = !open;
      burger.setAttribute("aria-expanded", String(open));
    };

    setOpen(false);

    burger.addEventListener("click", () => setOpen(panel.hidden));

    // Клик по пункту меню закрывает его: на якорях страница не перезагружается.
    panel.addEventListener("click", (event) => {
      if (event.target instanceof Element && event.target.closest("a")) {
        setOpen(false);
      }
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && !panel.hidden) {
        setOpen(false);
        burger.focus();
      }
    });

    desktop.addEventListener("change", (event) => {
      if (event.matches) setOpen(false);
    });
  }

  // === ПЕРЕКЛЮЧАТЕЛЬ ТЕМЫ ===
  // Светлая тема — по умолчанию, тема уже применена скриптом в <head>.
  const themeToggle = document.getElementById("themeToggle");
  const root = document.documentElement;

  themeToggle?.addEventListener("click", () => {
    const isDark = root.classList.toggle("dark");
    try {
      localStorage.setItem("theme", isDark ? "dark" : "light");
    } catch {}
  });
</script>
