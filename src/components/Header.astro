---
import { contacts } from '../data/contacts';
import ChatIcon from './ChatIcon.astro';

// Якоря пишем от корня, чтобы ссылки работали и с /projects, и со страницы 404.
const navLinks = [
  { name: "Работы", href: "/#works" },
  { name: "Цены", href: "/#services" },
  { name: "Как я работаю", href: "/#process" },
  { name: "Обо мне", href: "/#about" },
  { name: "Контакты", href: "/#contacts" },
];
---
<!-- Шапка — верхняя планка двери: та же стеклянная плоскость, что и
     главный экран, без своей подложки. Имя набрано плёнкой, как
     название мастерской над входом. -->
<header class="bg-glass">
  <div class="shell flex items-center justify-between gap-6 py-4">
    <a href="/" class="vinyl sign-sm flex min-h-[44px] items-center gap-2 text-vinyl" aria-label="Салима, Астана — на главную">
      {contacts.name}<span class="text-vinyl-muted" aria-hidden="true">·</span><span class="text-vinyl-muted">{contacts.city}</span>
    </a>

    <nav class="hidden md:flex md:items-center md:gap-7" aria-label="Основное меню">
      {navLinks.map(({ name, href }) => (
        <a href={href} class="text-vinyl-muted underline-offset-[0.3em] hover:text-vinyl hover:underline hover:decoration-vinyl">
          {name}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <a
        href={contacts.whatsapp}
        target="_blank"
        rel="noopener noreferrer"
        class="sticker hidden !min-h-[2.75rem] !px-4 !text-lg lg:inline-flex"
      >
        <ChatIcon size={20} />
        Написать
        <span class="sr-only">в WhatsApp (откроется в новой вкладке)</span>
      </a>

      <button
        id="burgermenu"
        class="flex h-11 w-11 items-center justify-center rounded-md border border-frame text-vinyl hover:border-vinyl md:hidden"
        aria-label="Меню"
        aria-controls="mobileNav"
        aria-expanded="false"
      >
        <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true">
          <path
            d="M3 5.5h14M3 10h14M3 14.5h14"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
          />
        </svg>
      </button>
    </div>
  </div>

  <!-- Выпадающее меню: отдельный блок под строкой шапки, а не внутри неё.
       Видимостью на десктопе управляет только CSS (md:hidden), состоянием
       на телефоне — атрибут hidden. Они не конфликтуют. -->
  <nav
    id="mobileNav"
    hidden
    class="shell flex flex-col border-t border-frame pb-3 md:hidden"
    aria-label="Мобильное меню"
  >
    {navLinks.map(({ name, href }) => (
      <a href={href} class="flex min-h-[48px] items-center border-b border-frame/50 text-vinyl">{name}</a>
    ))}
  </nav>
</header>

<!-- Липкая наклейка: на телефоне человек читает с прокруткой, и написать
     должно быть можно в любой момент. Пока на экране уже есть другая
     наклейка (на двери или в контактах), эта уезжает вниз, чтобы две
     одинаковые кнопки не спорили. Запас под жест "домой" на айфоне
     учтён в отступе body (--sticky-cta). -->
<a
  id="stickyCta"
  href={contacts.whatsapp}
  target="_blank"
  rel="noopener noreferrer"
  class="sticky-cta fixed inset-x-0 bottom-0 z-50 flex min-h-[var(--sticky-cta)] items-center justify-center gap-2.5 border-t-[3px] border-vinyl bg-sticker pb-[env(safe-area-inset-bottom,0px)] font-sign text-xl font-extrabold uppercase tracking-[0.02em] text-on-sticker focus-visible:outline-offset-[-6px] lg:hidden"
>
  <ChatIcon size={22} />
  Написать в WhatsApp
  <span class="sr-only">(откроется в новой вкладке)</span>
</a>

<script>
  // === БУРГЕР-МЕНЮ ===
  const burger = document.getElementById("burgermenu");
  const panel = document.getElementById("mobileNav");
  const desktop = window.matchMedia("(min-width: 768px)");

  if (burger && panel) {
    const setOpen = (open: boolean) => {
      panel.hidden = !open;
      burger.setAttribute("aria-expanded", String(open));
    };

    setOpen(false);

    burger.addEventListener("click", () => setOpen(panel.hidden));

    // Клик по пункту меню закрывает его: на якорях страница не перезагружается.
    panel.addEventListener("click", (event) => {
      if (event.target instanceof Element && event.target.closest("a")) {
        setOpen(false);
      }
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && !panel.hidden) {
        setOpen(false);
        burger.focus();
      }
    });

    // Ушли на десктопную ширину — сбрасываем состояние, чтобы при возврате
    // на узкий экран меню не оказалось открытым само по себе.
    desktop.addEventListener("change", (event) => {
      if (event.matches) setOpen(false);
    });
  }

  // === ЛИПКАЯ НАКЛЕЙКА ===
  // Прячем её, пока видна любая другая наклейка "написать" на странице
  // (помечены data-cta). Пока наклейка спрятана, она не принимает фокус.
  const sticky = document.getElementById("stickyCta");
  const others = document.querySelectorAll("[data-cta]");

  if (sticky && others.length > 0) {
    const visible = new Set<Element>();
    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) visible.add(entry.target);
        else visible.delete(entry.target);
      }
      const hide = visible.size > 0;
      sticky.classList.toggle("is-hidden", hide);
      sticky.toggleAttribute("inert", hide);
    });
    others.forEach((element) => observer.observe(element));
  }
</script>
