---
import { contacts } from '../data/contacts';
import ChatIcon from './ChatIcon.astro';

// Якоря пишем от корня, чтобы ссылки работали и с /projects, и со страницы 404.
const navLinks = [
  { name: "Работы", href: "/#works", screen: 2 },
  { name: "Цены", href: "/#services", screen: 3 },
  { name: "Как я работаю", href: "/#process", screen: 4 },
  { name: "Обо мне", href: "/#about", screen: 5 },
  { name: "Контакты", href: "/#contacts", screen: 6 },
];
---
<!-- Шапка — верхний ряд панно: полоса ночного кобальта поверх экранов.
     У пунктов меню номера экранов: видно, где вы и далеко ли до контактов. -->
<header class="fixed inset-x-0 top-0 z-40 bg-cobalt-deep">
  <div class="shell flex h-[var(--header-h)] items-center justify-between gap-4">
    <a href="/" class="display flex min-h-[44px] items-center gap-2 text-[0.9375rem] font-bold" aria-label="Салима, Астана — на главную">
      {contacts.name}<span class="text-on-cobalt-muted" aria-hidden="true">·</span><span class="font-semibold text-on-cobalt-muted">{contacts.city}</span>
    </a>

    <!-- Полное меню — от 1280px: уже на 1024px пункты переносились на две
         строки. Между 1024 и 1280 px — бургер и жёлтая кнопка рядом. -->
    <nav class="hidden xl:flex xl:items-center xl:gap-6" aria-label="Основное меню">
      {navLinks.map(({ name, href, screen }) => (
        <a href={href} data-nav={screen} class="group inline-flex min-h-[44px] items-center gap-2 whitespace-nowrap text-on-cobalt-muted hover:text-on-cobalt aria-[current=true]:text-on-cobalt">
          <span class="label grid h-6 w-6 place-items-center rounded-[2px] border-2 border-dashed border-on-cobalt-muted text-[0.6875rem] group-aria-[current=true]:border-solid group-aria-[current=true]:border-on-cobalt group-aria-[current=true]:bg-on-cobalt group-aria-[current=true]:text-cobalt-deep" aria-hidden="true">{screen}</span>
          {name}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">

      <a
        href={contacts.whatsapp}
        target="_blank"
        rel="noopener noreferrer"
        id="headerCta"
        class="smalt hidden !min-h-[2.75rem] !px-4 !text-[0.9375rem] transition-opacity lg:inline-flex [&.is-hidden]:pointer-events-none [&.is-hidden]:opacity-0"
      >
        <ChatIcon size={18} />
        Написать
        <span class="sr-only">в WhatsApp (откроется в новой вкладке)</span>
      </a>

      <button
        id="burgermenu"
        class="flex h-11 w-11 items-center justify-center rounded-[2px] border-2 border-on-cobalt-muted text-on-cobalt hover:border-on-cobalt xl:hidden"
        aria-label="Меню"
        aria-controls="mobileNav"
        aria-expanded="false"
      >
        <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true">
          <path d="M3 5.5h14M3 10h14M3 14.5h14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Меню на телефоне: плитки под шапкой. Видимостью на десктопе
       управляет CSS (xl:hidden), ниже — атрибут hidden. -->
  <nav id="mobileNav" hidden class="shell grid gap-[var(--seam)] pb-4 xl:hidden" aria-label="Мобильное меню">
    {navLinks.map(({ name, href, screen }) => (
      <a href={href} class="flex min-h-[52px] items-center gap-3 rounded-[2px] bg-cobalt px-4 font-semibold">
        <span class="label text-on-cobalt-muted" aria-hidden="true">{screen}</span>{name}
      </a>
    ))}
  </nav>
</header>

<!-- Липкая кнопка: на телефоне написать должно быть можно с любого
     экрана. Пока на экране уже есть другая жёлтая плитка или форма
     заявки, эта уезжает вниз, чтобы кнопки не спорили. -->
<a
  id="stickyCta"
  href={contacts.whatsapp}
  target="_blank"
  rel="noopener noreferrer"
  class="sticky-cta display fixed inset-x-0 bottom-0 z-50 flex min-h-[var(--sticky-cta)] items-center justify-center gap-2.5 bg-smalt pb-[env(safe-area-inset-bottom,0px)] text-[1.0625rem] font-bold text-on-smalt focus-visible:outline-offset-[-6px] focus-visible:outline-cobalt lg:hidden"
>
  <ChatIcon size={22} />
  Написать в WhatsApp
  <span class="sr-only">(откроется в новой вкладке)</span>
</a>

<script>
  // === МЕНЮ ===
  const burger = document.getElementById("burgermenu");
  const panel = document.getElementById("mobileNav");
  const desktop = window.matchMedia("(min-width: 1280px)");

  if (burger && panel) {
    const setOpen = (open: boolean) => {
      panel.hidden = !open;
      burger.setAttribute("aria-expanded", String(open));
    };

    setOpen(false);
    burger.addEventListener("click", () => setOpen(panel.hidden));

    // Клик по пункту меню закрывает его: на якорях страница не перезагружается.
    panel.addEventListener("click", (event) => {
      if (event.target instanceof Element && event.target.closest("a")) setOpen(false);
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && !panel.hidden) {
        setOpen(false);
        burger.focus();
      }
    });

    desktop.addEventListener("change", (event) => {
      if (event.matches) setOpen(false);
    });
  }

  // === АДРЕС ЭКРАНА ===
  // Какой экран сейчас стоит в окне: отмеченный пункт меню.
  // Заодно экран, впервые вставший на место, укладывает свои плитки.
  const screens = Array.from(document.querySelectorAll<HTMLElement>("[data-screen]"));

  if (screens.length > 0) {
    const setCurrent = (screen: HTMLElement) => {
      const number = Number(screen.dataset.screen);
      document.querySelectorAll<HTMLElement>("[data-nav]").forEach((link) => {
        link.setAttribute("aria-current", String(Number(link.dataset.nav) === number));
      });
    };

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const screen = entry.target as HTMLElement;
          screen.classList.add("is-laid");
          setCurrent(screen);
        }
      },
      // Экран считается текущим, когда пересекает середину окна.
      { rootMargin: "-50% 0px -50% 0px" }
    );
    screens.forEach((screen) => observer.observe(screen));
  }

  // === ЛИПКАЯ КНОПКА ===
  // Прячем её, пока видна любая другая жёлтая плитка "написать"
  // (помечены data-cta) или форма заявки (data-hides-sticky): у формы своя
  // главная кнопка, и жёлтая полоса под ней уводила бы из начатой заявки.
  // Пока кнопка спрятана, она не принимает фокус.
  // То же для жёлтой кнопки в шапке на компьютере: на экране одна жёлтая
  // плитка, а не две рядом.
  const repeats = ["stickyCta", "headerCta"]
    .map((id) => document.getElementById(id))
    .filter((element): element is HTMLElement => element !== null);
  const others = document.querySelectorAll("[data-cta], [data-hides-sticky]");

  if (repeats.length > 0 && others.length > 0) {
    const visible = new Set<Element>();
    const observer = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        if (entry.isIntersecting) visible.add(entry.target);
        else visible.delete(entry.target);
      }
      const hide = visible.size > 0;
      repeats.forEach((cta) => {
        cta.classList.toggle("is-hidden", hide);
        cta.toggleAttribute("inert", hide);
      });
    });
    others.forEach((element) => observer.observe(element));
  }
</script>
