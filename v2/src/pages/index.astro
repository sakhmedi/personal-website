---
import Layout from '../layouts/Layout.astro';
import Cards from '../components/Cards.astro';
import Form from '../components/Form.astro';
import { featuredProjects } from '../data/projects';
import { contacts } from '../data/contacts';
---
<Layout
  title="Салима — сайты для бизнеса в Астане"
  description="Лендинги, сайты-визитки и доработка существующих сайтов. Астана."
>
  <!-- ГЛАВНЫЙ ЭКРАН -->
  <section class="max-w-5xl mx-auto px-5 pt-16 pb-20">
    <h1 class="text-3xl sm:text-5xl font-bold leading-tight mb-6">
      Делаю сайты для бизнеса в Астане
    </h1>
    <p class="text-lg text-text-muted max-w-2xl mb-8 leading-relaxed">
      Ваш клиент заходит с телефона, сразу видит главное и пишет вам в WhatsApp.
      Без долгой загрузки и лишних форм.
    </p>
    <a
      href={contacts.whatsapp}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-block px-6 py-3 rounded-xl bg-accent text-on-accent font-semibold hover:bg-accent-hover transition-colors"
    >
      Написать в WhatsApp
    </a>
  </section>

  <!-- РАБОТЫ -->
  <section id="works" class="max-w-5xl mx-auto px-5 py-16 scroll-mt-8">
    <h2 class="text-2xl font-bold mb-6">Работы</h2>

    <div class="grid gap-6 md:grid-cols-2">
      {featuredProjects.map((project, index) => (
        <Cards project={project} eager={index === 0} />
      ))}
    </div>

    <a href="/projects" class="inline-block mt-6 text-accent">Все работы →</a>
  </section>

  <!-- ЧТО Я ДЕЛАЮ -->
  <section id="services" class="max-w-3xl mx-auto px-5 py-16 scroll-mt-8">
    <h2 class="text-2xl font-bold mb-6">Что я делаю</h2>

    <div class="flex flex-col gap-4 text-lg leading-relaxed">
      <p>Нужно, чтобы про вас узнали и написали — сделаю лендинг: одна страница, одно действие.</p>
      <p>Рассказать надо больше — соберу сайт-визитку на несколько страниц.</p>
      <p>
        Сайт уже есть, но вас не устраивает — чаще всего его можно доработать,
        а не выбрасывать. Посмотрю и скажу честно.
      </p>
      <p>Основной язык — Go.</p>
    </div>
  </section>

  <!-- КОНТАКТЫ -->
  <section id="contacts" class="max-w-3xl mx-auto px-5 py-16 scroll-mt-8">
    <h2 class="text-2xl font-bold mb-4">Контакты</h2>
    <p class="text-lg text-text-muted mb-8">
      Самый быстрый способ — WhatsApp. Отвечаю в течение дня.
    </p>

    <a
      href={contacts.whatsapp}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-block px-6 py-3 rounded-xl bg-accent text-on-accent font-semibold hover:bg-accent-hover transition-colors"
    >
      Написать в WhatsApp
    </a>

    <ul class="flex flex-col gap-3 mt-8">
      <li>
        <a href={contacts.telegram} target="_blank" rel="noopener noreferrer" class="text-accent">
          Telegram
        </a>
      </li>
      <li>
        <a href={`mailto:${contacts.email}`} class="text-accent">{contacts.email}</a>
      </li>
      <li>
        <a href={contacts.github} target="_blank" rel="noopener noreferrer" class="text-accent">
          github.com/sakhmedi
        </a>
      </li>
    </ul>

    <p class="mt-10 mb-4 text-text-muted">Или оставьте заявку — напишу сама.</p>
    <Form />
  </section>
</Layout>
