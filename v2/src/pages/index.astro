---
import Layout from '../layouts/Layout.astro';
import Cards from '../components/Cards.astro';
import { featuredProjects } from '../data/projects';
---
<Layout
  title="Салима — сайты для бизнеса в Астане"
  description="Разработка сайтов для бизнеса в Астане: лендинги, сайты-визитки, доработка существующего сайта."
>
  <section class="max-w-5xl mx-auto px-5 py-16">
    <h1 class="text-3xl sm:text-4xl font-bold">Делаю сайты для бизнеса в Астане</h1>
  </section>

  <section class="max-w-5xl mx-auto px-5 pb-16">
    <h2 class="text-2xl font-bold mb-6">Работы</h2>

    <div class="grid gap-6 md:grid-cols-2">
      {featuredProjects.map((project) => <Cards project={project} />)}
    </div>

    <a href="/projects" class="inline-block mt-6 text-accent">Все работы</a>
  </section>
</Layout>
