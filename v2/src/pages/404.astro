---
import Layout from '../layouts/Layout.astro';
---
<Layout
  title="Страница не найдена — Салима"
  description="Такой страницы на сайте нет."
>
  <section class="max-w-xl mx-auto px-5 py-20 text-center">
    <p class="text-6xl font-bold text-accent mb-4">404</p>
    <h1 class="text-2xl font-bold mb-4">Такой страницы нет</h1>
    <p class="text-text-muted mb-8">
      Возможно, адрес набран с опечаткой или страница переехала.
    </p>
    <a
      href="/"
      class="inline-block p-3 px-6 rounded-xl bg-accent text-on-accent hover:bg-accent-hover transition-colors"
    >
      На главную
    </a>
  </section>
</Layout>
