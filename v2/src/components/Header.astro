---
import { Image } from 'astro:assets';
import salima from '../assets/salima.jpg';
import { contacts } from '../data/contacts';

// Якоря пишем от корня, чтобы ссылки работали и с /projects, и со страницы 404.
const navLinks = [
  { name: "Работы", href: "/#works" },
  { name: "Что я делаю", href: "/#services" },
  { name: "Контакты", href: "/#contacts" },
];
---
<header class="border-b border-accent bg-surface-raised">
  <div class="max-w-5xl mx-auto flex flex-row items-center justify-between gap-6 p-5">
    <a href="/" class="flex items-center gap-3" aria-label="На главную">
      <Image
        src={salima}
        alt=""
        width={96}
        height={96}
        densities={[1, 2]}
        loading="eager"
        class="w-12 h-12 object-cover rounded-full border-2 border-accent"
      />
      <span class="text-lg font-bold">{contacts.name}</span>
    </a>

    <nav class="hidden md:flex md:flex-row gap-6 items-center" aria-label="Основное меню">
      {navLinks.map(({ name, href }) => (
        <a href={href} class="text-accent">{name}</a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <a
        href={contacts.whatsapp}
        target="_blank"
        rel="noopener noreferrer"
        class="hidden md:inline-block px-4 py-2 rounded-xl bg-accent text-on-accent hover:bg-accent-hover transition-colors"
      >
        Написать в WhatsApp
      </a>

      <button id="themeToggle" class="p-2 border rounded border-accent text-text min-w-[40px]" aria-label="Переключить тему">
        🌓
      </button>

      <button
        id="burgermenu"
        class="md:hidden p-2 border rounded border-accent text-text min-w-[40px]"
        aria-label="Меню"
        aria-controls="mobileNav"
        aria-expanded="false"
      >
        ☰
      </button>
    </div>
  </div>

  <!-- Выпадающее меню: отдельный блок под строкой шапки, а не внутри неё.
       Видимостью на десктопе управляет только CSS (md:hidden), состоянием
       на телефоне — атрибут hidden. Они не конфликтуют. -->
  <nav
    id="mobileNav"
    hidden
    class="md:hidden flex flex-col border-t border-border px-5 pb-4"
    aria-label="Мобильное меню"
  >
    {navLinks.map(({ name, href }) => (
      <a href={href} class="text-accent py-3">{name}</a>
    ))}
  </nav>
</header>

<!-- Липкая кнопка: на телефоне человек читает с прокруткой, и связаться
     должно быть можно в любой момент, не возвращаясь наверх. -->
<a
  href={contacts.whatsapp}
  target="_blank"
  rel="noopener noreferrer"
  class="md:hidden fixed inset-x-0 bottom-0 z-50 p-4 text-center font-semibold bg-accent text-on-accent border-t border-accent-hover"
>
  Написать в WhatsApp
</a>

<script>
  // === БУРГЕР-МЕНЮ ===
  const burger = document.getElementById("burgermenu");
  const panel = document.getElementById("mobileNav");
  const desktop = window.matchMedia("(min-width: 768px)");

  if (burger && panel) {
    const setOpen = (open: boolean) => {
      panel.hidden = !open;
      burger.setAttribute("aria-expanded", String(open));
    };

    setOpen(false);

    burger.addEventListener("click", () => setOpen(panel.hidden));

    // Клик по пункту меню закрывает его: на якорях страница не перезагружается.
    panel.addEventListener("click", (event) => {
      if (event.target instanceof Element && event.target.closest("a")) {
        setOpen(false);
      }
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && !panel.hidden) {
        setOpen(false);
        burger.focus();
      }
    });

    // Ушли на десктопную ширину — сбрасываем состояние, чтобы при возврате
    // на узкий экран меню не оказалось открытым само по себе.
    desktop.addEventListener("change", (event) => {
      if (event.matches) setOpen(false);
    });
  }

  // === ПЕРЕКЛЮЧАТЕЛЬ ТЕМЫ ===
  // Тема уже применена скриптом в <head>, здесь только переключение.
  const themeToggle = document.getElementById("themeToggle");
  const root = document.documentElement;

  themeToggle?.addEventListener("click", () => {
    const isLight = root.classList.toggle("light");
    localStorage.setItem("theme", isLight ? "light" : "dark");
  });
</script>
