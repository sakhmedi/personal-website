---
import { Image } from 'astro:assets';
import salima from '../assets/salima.jpg';
import { contacts } from '../data/contacts';

// Якоря пишем от корня, чтобы ссылки работали и с /projects, и со страницы 404.
const navLinks = [
  { name: "Работы", href: "/#works" },
  { name: "Что я делаю", href: "/#services" },
  { name: "Как я работаю", href: "/#process" },
  { name: "Контакты", href: "/#contacts" },
];

const iconButton =
  "flex h-11 w-11 items-center justify-center rounded-md border border-border text-text hover:border-border-strong";
---
<header class="border-b-2 border-accent bg-surface-raised">
  <div class="mx-auto flex max-w-[1120px] flex-row items-center justify-between gap-6 px-5 py-3">
    <a href="/" class="flex items-center gap-3" aria-label="На главную">
      <Image
        src={salima}
        alt=""
        width={96}
        height={96}
        densities={[1, 2]}
        loading="eager"
        class="h-11 w-11 rounded-full border border-border object-cover"
      />
      <span class="font-bold">{contacts.name}</span>
    </a>

    <nav class="hidden md:flex md:flex-row md:items-center md:gap-7" aria-label="Основное меню">
      {navLinks.map(({ name, href }) => (
        <a href={href} class="text-text underline-offset-4 hover:text-accent hover:underline">
          {name}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={contacts.whatsapp}
        target="_blank"
        rel="noopener noreferrer"
        class="btn hidden lg:inline-flex"
      >
        Написать в WhatsApp
      </a>

      <button id="themeToggle" class={iconButton} aria-label="Переключить тему">
        <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true">
          <circle cx="10" cy="10" r="7.25" fill="none" stroke="currentColor" stroke-width="1.5" />
          <path d="M10 2.75a7.25 7.25 0 0 1 0 14.5z" fill="currentColor" />
        </svg>
      </button>

      <button
        id="burgermenu"
        class={`md:hidden ${iconButton}`}
        aria-label="Меню"
        aria-controls="mobileNav"
        aria-expanded="false"
      >
        <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true">
          <path
            d="M3 5.5h14M3 10h14M3 14.5h14"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
          />
        </svg>
      </button>
    </div>
  </div>

  <!-- Выпадающее меню: отдельный блок под строкой шапки, а не внутри неё.
       Видимостью на десктопе управляет только CSS (md:hidden), состоянием
       на телефоне — атрибут hidden. Они не конфликтуют. -->
  <nav
    id="mobileNav"
    hidden
    class="flex flex-col border-t border-border px-5 pb-3 md:hidden"
    aria-label="Мобильное меню"
  >
    {navLinks.map(({ name, href }) => (
      <a href={href} class="flex min-h-[44px] items-center text-text">{name}</a>
    ))}
  </nav>
</header>

<!-- Липкая кнопка: на телефоне человек читает с прокруткой, и связаться
     должно быть можно в любой момент, не возвращаясь наверх. Высота и
     запас под жест "домой" на айфоне учтены в отступе body (--sticky-cta).
     Рамка фокуса уходит внутрь: снаружи её срезал бы край экрана. -->
<a
  href={contacts.whatsapp}
  target="_blank"
  rel="noopener noreferrer"
  class="fixed inset-x-0 bottom-0 z-50 flex min-h-[var(--sticky-cta)] items-center justify-center bg-accent pb-[env(safe-area-inset-bottom,0px)] text-center font-medium text-on-accent focus-visible:outline-offset-[-4px] lg:hidden"
>
  Написать в WhatsApp
</a>

<script>
  // === БУРГЕР-МЕНЮ ===
  const burger = document.getElementById("burgermenu");
  const panel = document.getElementById("mobileNav");
  const desktop = window.matchMedia("(min-width: 768px)");

  if (burger && panel) {
    const setOpen = (open: boolean) => {
      panel.hidden = !open;
      burger.setAttribute("aria-expanded", String(open));
    };

    setOpen(false);

    burger.addEventListener("click", () => setOpen(panel.hidden));

    // Клик по пункту меню закрывает его: на якорях страница не перезагружается.
    panel.addEventListener("click", (event) => {
      if (event.target instanceof Element && event.target.closest("a")) {
        setOpen(false);
      }
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && !panel.hidden) {
        setOpen(false);
        burger.focus();
      }
    });

    // Ушли на десктопную ширину — сбрасываем состояние, чтобы при возврате
    // на узкий экран меню не оказалось открытым само по себе.
    desktop.addEventListener("change", (event) => {
      if (event.matches) setOpen(false);
    });
  }

  // === ПЕРЕКЛЮЧАТЕЛЬ ТЕМЫ ===
  // Светлая тема — по умолчанию, в localStorage попадает только выбор
  // "dark". Тема уже применена скриптом в <head>, здесь только переключение.
  const themeToggle = document.getElementById("themeToggle");
  const root = document.documentElement;

  themeToggle?.addEventListener("click", () => {
    const isDark = root.classList.toggle("dark");
    localStorage.setItem("theme", isDark ? "dark" : "light");
  });
</script>
