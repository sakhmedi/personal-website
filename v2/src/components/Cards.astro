---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  /** Первая карточка на главной видна сразу — её картинку грузим не лениво. */
  eager?: boolean;
}

const { project, eager = false } = Astro.props;

// Astro оптимизирует только те картинки, про которые знает на сборке.
// Импортировать по переменной нельзя, поэтому забираем всю папку разом,
// а нужный файл достаём по имени из данных.
const screens = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/screens/*.png',
  { eager: true }
);
const screen = project.image
  ? screens[`../assets/screens/${project.image}`]?.default
  : undefined;

// Домен показываем вместо слов "Открыть сайт": адрес можно проверить,
// обещание — нет. Параметры и www. только мешают читать.
const host = new URL(project.url).hostname.replace(/^www\./, '');

// Первый тег — статус работы ("Концепт", "Учебный проект"). Он в рамке,
// остальные — просто подписи: человек должен увидеть статус первым,
// а не после перехода на сайт.
const [statusTag, ...otherTags] = project.tags;
---

<article class="group relative flex flex-col rounded-md border border-border bg-surface-raised">
  {screen && (
    <div class="rounded-t-md bg-surface p-2.5">
      <Image
        src={screen}
        alt={project.imageAlt}
        widths={[440, 880]}
        sizes="(min-width: 768px) 548px, 92vw"
        width={880}
        height={550}
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : 'auto'}
        class="shot"
      />
    </div>
  )}

  <div class="flex grow flex-col gap-2 border-t border-border p-5">
    <div class="mb-1 flex flex-wrap items-center gap-x-3 gap-y-2">
      <span class="tag-status">{statusTag}</span>
      {otherTags.map((tag) => <span class="tag">{tag}</span>)}
    </div>

    <h3>{project.title}</h3>
    <p class="text-[0.9375rem] text-text-muted">{project.subtitle}</p>
    <p class="measure">{project.description}</p>

    <!-- Ссылка растянута на всю карточку через ::after: на телефоне
         промахнуться по адресу в 13px иначе слишком легко. Своей высоты
         у неё тоже хватает — 44px вместе с отступами. -->
    <a
      href={project.url}
      target="_blank"
      rel="noopener noreferrer"
      class="addr mt-auto inline-flex min-h-[44px] items-center pt-3 text-accent underline underline-offset-4 after:absolute after:inset-0 after:rounded-md hover:text-accent-hover"
    >
      {host}
      <span class="sr-only">(откроется в новой вкладке)</span>
    </a>
  </div>
</article>
