---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  /** Первая карточка на главной видна сразу — её картинку грузим не лениво. */
  eager?: boolean;
}

const { project, eager = false } = Astro.props;

// Astro оптимизирует только те картинки, про которые знает на сборке.
// Импортировать по переменной нельзя, поэтому забираем всю папку разом,
// а нужный файл достаём по имени из данных.
const screens = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/screens/*.png',
  { eager: true }
);
const screen = project.image
  ? screens[`../assets/screens/${project.image}`]?.default
  : undefined;

// Домен показываем вместо слов "Открыть сайт": адрес можно проверить,
// обещание — нет. Параметры и www. только мешают читать.
const host = new URL(project.url).hostname.replace(/^www\./, '');
---

<!-- Работа лежит прямо на листе. Единственная рамка на всю карточку —
     рамка скриншота: она отделяет светлую чужую страницу от светлого
     листа и держит вес, который раньше делили коробка, подложка и текст. -->
<article class="group relative flex flex-col">
  {screen && (
    <Image
      src={screen}
      alt={project.imageAlt}
      widths={[440, 880]}
      sizes="(min-width: 768px) 548px, calc(100vw - 2.5rem)"
      width={880}
      height={550}
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : 'auto'}
      class="shot"
    />
  )}

  <!-- Подпись под работой: название, следом статус в подзаголовке.
       Всё, кроме названия, набрано мельче основного текста и приглушённым,
       чтобы не спорить со скриншотом. -->
  <div class="flex grow flex-col gap-2 pt-4">
    <h3>{project.title}</h3>

    <div class="flex flex-col gap-1.5 text-[0.9375rem] text-text-muted">
      <p>{project.subtitle}</p>
      <p class="measure leading-relaxed">{project.description}</p>
    </div>

    <!-- Ссылка растянута на всю карточку через ::after: на телефоне
         промахнуться по адресу в 13px иначе слишком легко. Своей высоты
         у неё тоже хватает — 44px вместе с отступами. -->
    <a
      href={project.url}
      target="_blank"
      rel="noopener noreferrer"
      class="addr mt-auto inline-flex min-h-[44px] items-center pt-2 text-accent underline underline-offset-4 after:absolute after:inset-0 hover:text-accent-hover"
    >
      {host}
      <span class="sr-only">(откроется в новой вкладке)</span>
    </a>
  </div>
</article>
