  "components": [
    {
      "name": "Смальта «написать»",
      "kind": "button",
      "refersTo": "smalt",
      "description": "Единственная жёлтая плитка: действие «написать в WhatsApp». Одна на экран.",
      "html": "<div class=\"ds-field\"><a href=\"#\" class=\"ds-smalt\"><svg viewBox=\"0 0 24 24\" width=\"24\" height=\"24\" aria-hidden=\"true\" fill=\"none\"><path d=\"M4 5.5A1.5 1.5 0 0 1 5.5 4h13A1.5 1.5 0 0 1 20 5.5v9a1.5 1.5 0 0 1-1.5 1.5H10l-4.2 3.6c-.3.3-.8 0-.8-.4V16h0a1.5 1.5 0 0 1-1-1.4z\" stroke=\"currentColor\" stroke-width=\"2.25\" stroke-linejoin=\"round\"/><path d=\"M8.5 9h7M8.5 12h4.5\" stroke=\"currentColor\" stroke-width=\"2.25\" stroke-linecap=\"round\"/></svg>Написать в WhatsApp</a></div>",
      "css": ":host{--cobalt:#1b3a8a;--cobalt-deep:#0f2459;--terracotta:#c4532d;--terracotta-ink:#9b3b1b;--on-cobalt:#fff;--on-cobalt-muted:#c3cdea;--stone:#eef0f2;--stone-line:#9aa2b1;--ink:#141821;--ink-muted:#4a5263;--link:#1b3a8a;--field:#fff;--field-border:#6b7384;--smalt:#ffd31a;--smalt-hover:#f2c400;--on-smalt:#1c1800;--danger:#a3201a;--seam:6px} .ds-field{background:var(--cobalt);padding:24px} .ds-smalt{display:inline-flex;align-items:center;justify-content:center;gap:.625rem;min-height:3.5rem;padding:.75rem 1.5rem;border-radius:2px;background:var(--smalt);color:var(--on-smalt);font-family:'Unbounded Variable','Onest Variable',system-ui,sans-serif;font-weight:700;font-size:1.0625rem;letter-spacing:.01em;line-height:1.1;text-decoration:none;transition:background-color 140ms ease,transform 140ms ease} .ds-smalt:hover{background:var(--smalt-hover)} .ds-smalt:active{transform:translateY(1px)} .ds-smalt:focus-visible{outline:3px solid var(--smalt);outline-offset:3px}"
    },
    {
      "name": "Обычная кнопка",
      "kind": "button",
      "refersTo": "button",
      "description": "Кобальтовая плитка для всего, что не «написать».",
      "html": "<div class=\"ds-tile-bg\"><button class=\"ds-btn\">Отправить</button></div>",
      "css": ":host{--cobalt:#1b3a8a;--cobalt-deep:#0f2459;--terracotta:#c4532d;--terracotta-ink:#9b3b1b;--on-cobalt:#fff;--on-cobalt-muted:#c3cdea;--stone:#eef0f2;--stone-line:#9aa2b1;--ink:#141821;--ink-muted:#4a5263;--link:#1b3a8a;--field:#fff;--field-border:#6b7384;--smalt:#ffd31a;--smalt-hover:#f2c400;--on-smalt:#1c1800;--danger:#a3201a;--seam:6px} .ds-tile-bg{background:var(--stone);padding:24px;border-radius:2px} .ds-btn{display:inline-flex;align-items:center;justify-content:center;min-height:3rem;padding:.75rem 1.5rem;border:0;border-radius:2px;background:var(--cobalt);color:var(--on-cobalt);font-family:'Onest Variable',system-ui,sans-serif;font-weight:600;font-size:1rem;transition:background-color 140ms ease;cursor:pointer} .ds-btn:hover{background:var(--cobalt-deep)} .ds-btn:focus-visible{outline:3px solid var(--cobalt);outline-offset:3px} .ds-btn:disabled{opacity:.6}"
    },
    {
      "name": "Плитка тарифа",
      "kind": "card",
      "refersTo": "tile",
      "description": "Камень на кобальте: название, цена, срок, «что входит» с терракотовыми метками.",
      "html": "<div class=\"ds-field\"><article class=\"ds-tile\"><h3 class=\"ds-dmd\">Сайт на одну страницу</h3><p class=\"ds-price\"><small>от </small>80&#8239;000<small> ₸</small></p><p class=\"ds-strong\">Срок: обычно 2–3 дня</p><div class=\"ds-rule\"><p class=\"ds-label\">Что входит</p><ul class=\"ds-ticks\"><li>два круга правок</li><li>домен и хостинг оформлены на вас</li></ul></div></article></div>",
      "css": ":host{--cobalt:#1b3a8a;--cobalt-deep:#0f2459;--terracotta:#c4532d;--terracotta-ink:#9b3b1b;--on-cobalt:#fff;--on-cobalt-muted:#c3cdea;--stone:#eef0f2;--stone-line:#9aa2b1;--ink:#141821;--ink-muted:#4a5263;--link:#1b3a8a;--field:#fff;--field-border:#6b7384;--smalt:#ffd31a;--smalt-hover:#f2c400;--on-smalt:#1c1800;--danger:#a3201a;--seam:6px} .ds-field{background:var(--cobalt);padding:24px} .ds-tile{display:flex;flex-direction:column;gap:.625rem;background:var(--stone);color:var(--ink);border-radius:2px;padding:1.75rem;max-width:22rem;font-family:'Onest Variable',system-ui,sans-serif;font-size:1rem;line-height:1.5} .ds-dmd{font-family:'Unbounded Variable','Onest Variable',system-ui,sans-serif;font-weight:700;font-size:1.5rem;line-height:1.04;letter-spacing:-.01em;margin:0} .ds-price{font-family:'Unbounded Variable','Onest Variable',system-ui,sans-serif;font-weight:700;font-size:2rem;line-height:1;white-space:nowrap;margin:0;font-variant-numeric:tabular-nums} .ds-price small{font-size:.5em;font-weight:600;letter-spacing:.04em;text-transform:uppercase} .ds-strong{font-weight:600;margin:0} .ds-rule{border-top:1px solid var(--stone-line);padding-top:.75rem} .ds-label{font-family:'Unbounded Variable','Onest Variable',system-ui,sans-serif;font-weight:600;font-size:.75rem;letter-spacing:.08em;text-transform:uppercase;line-height:1.2;color:var(--ink-muted);margin:0 0 .5rem} .ds-ticks{list-style:none;margin:0;padding:0;font-size:.9375rem} .ds-ticks li{position:relative;padding-left:1.125rem} .ds-ticks li::before{content:\"\";position:absolute;left:0;top:.55em;width:.45rem;height:.45rem;background:var(--terracotta)}"
    },
    {
      "name": "Плашка платного шага",
      "kind": "chip",
      "refersTo": "price-chip",
      "description": "Сумма «50%» на терракоте отмечает шаг, где клиент платит.",
      "html": "<div class=\"ds-tile\"><span class=\"ds-label\">Вы платите мне</span><span class=\"ds-price ds-paid\">50%</span><span class=\"ds-label\">Вы платите мне</span><span class=\"ds-price\">0 ₸</span></div>",
      "css": ":host{--cobalt:#1b3a8a;--cobalt-deep:#0f2459;--terracotta:#c4532d;--terracotta-ink:#9b3b1b;--on-cobalt:#fff;--on-cobalt-muted:#c3cdea;--stone:#eef0f2;--stone-line:#9aa2b1;--ink:#141821;--ink-muted:#4a5263;--link:#1b3a8a;--field:#fff;--field-border:#6b7384;--smalt:#ffd31a;--smalt-hover:#f2c400;--on-smalt:#1c1800;--danger:#a3201a;--seam:6px} .ds-tile{display:flex;flex-direction:column;align-items:flex-start;gap:.25rem;background:var(--stone);color:var(--ink);padding:1.125rem;border-radius:2px} .ds-label{font-family:'Unbounded Variable','Onest Variable',system-ui,sans-serif;font-weight:600;font-size:.75rem;letter-spacing:.08em;text-transform:uppercase;color:var(--ink-muted)} .ds-price{font-family:'Unbounded Variable','Onest Variable',system-ui,sans-serif;font-weight:700;font-size:2rem;line-height:1;font-variant-numeric:tabular-nums;margin-bottom:.75rem} .ds-paid{background:var(--terracotta);color:var(--on-cobalt);border-radius:2px;padding:.375rem .5rem}"
